<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code fixes live in their OWN assembly: CodeFixProvider is defined in
       Microsoft.CodeAnalysis.Workspaces, and that reference in an analyzer
       assembly trips RS1038. So the Workspaces reference goes here, not in
       MyApp.Analyzers. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
